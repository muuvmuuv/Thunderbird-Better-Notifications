{
  "manifest_version": 3,
  "name": "Account Notify",
  "version": "0.2.1",
  "description": "New mail notifications and app icon badge per account and folder.",
  "browser_specific_settings": {
    "gecko": {
      "id": "account-notify@marvin.digital",
      "strict_min_version": "128.0"
    }
  },
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
  "permissions": ["accountsRead", "messagesRead", "notifications", "storage"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "options/options.html" },
  "experiment_apis": {
    "unreadBadge": {
      "schema": "api/unreadBadge/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["unreadBadge"]],
        "script": "api/unreadBadge/implementation.js"
      }
    }
  }
}
